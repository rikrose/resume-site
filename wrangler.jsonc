{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resume-website",
  "compatibility_date": "2026-11-01",

  // Wrangler runs this before every `deploy` and `dev`. It must be the package
  // `build` script (not bare `vp build`): that also fills in the CSP script
  // hashes in _headers, and without them the page's inline scripts are blocked.
  "build": { "command": "vp run build" },

  // The Worker script only handles the contact form API (/api/*). Every other
  // request is answered straight from the static assets without running it.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Unknown paths get public/404.html with a real 404 status.
    "not_found_handling": "404-page",
  },

  // Serve only on the custom domain. Cloudflare creates the DNS record and
  // certificate for it on the first deploy (your domain's zone, e.g. example.com, must be in
  // the same account).
  "routes": [{ "pattern": "resume.example.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // Contact form messages are sent through the Resend API (worker/index.ts).

  // Per-IP limit on contact form submissions (period must be 10 or 60 s).
  // namespace_id is any integer string that is unique within the account.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],

  "vars": {
    // Sender of the notification emails. Must be an address on a domain
    // verified in Resend (it doesn't need to be a real mailbox).
    "CONTACT_FROM": "",
  },
  // Secrets (set with `wrangler secret put <NAME>`; for local dev, .dev.vars):
  //   CONTACT_TO            where contact form messages are delivered
  //   RESEND_API_KEY        Resend API key with permission to send
  //   TURNSTILE_SECRET_KEY  secret key of the site's Turnstile widget
  // Local only: CONTACT_DRY_RUN=true in .dev.vars logs messages instead of
  // sending them. Never set it in production.

  "observability": { "enabled": true },
}
